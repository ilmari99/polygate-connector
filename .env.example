# === Polymarket Research MCP configuration ===
# Copy to `.env` (or export as environment variables). No secrets exist:
# every setting is operational.

# Public hostname the connector is reached at. REQUIRED for HTTP serving;
# Host/Origin validation is pinned to it.
PUBLIC_HOST=mcp.example.com

# --- Optional knobs (defaults shown) ---
# BIND_HOST=127.0.0.1
# BIND_PORT=8765
# RATE_LIMIT_PER_IP=60/minute
# RATE_LIMIT_GLOBAL=600/minute
# UPSTREAM_CONCURRENCY=8
# HTTP_TIMEOUT_SECONDS=15.0
# HTTP_MAX_RETRIES=3
# LOG_LEVEL=INFO
# GAMMA_HOST=https://gamma-api.polymarket.com
# CLOB_HOST=https://clob.polymarket.com
# DATA_HOST=https://data-api.polymarket.com
